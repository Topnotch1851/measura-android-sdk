<?xml version="1.0" encoding="utf-8"?>
<!--
  Measura SDK harness.

  INTERNET and ACCESS_NETWORK_STATE arrive by manifest merge from the SDK, so
  they are not repeated here. Nothing else is requested: the harness has no
  business asking for permissions the SDK itself does not need.

  The VIEW intent filter exists so deep links can be exercised without a real
  ad network. It accepts a private scheme, which `adb shell am start` can fire
  directly, so a deferred-deep-link scenario is reproducible on an emulator.
  That is a SIMULATED signal and the UI labels it as one: a private scheme is
  not equivalent to a Play Store install carrying a genuine referrer.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".HarnessApp"
        android:label="Measura SDK Lab"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- measura-harness://open?measura_click_id=<uuid>&campaign=<name> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="measura-harness" />
            </intent-filter>
        </activity>
    </application>

</manifest>
